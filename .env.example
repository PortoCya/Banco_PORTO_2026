# Configurações da aplicação — copie este arquivo para .env e preencha
APP_NAME="AI Consulting Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Banco de dados
# SQLite (desenvolvimento):
DATABASE_URL=sqlite:///./ai_consulting.db
# PostgreSQL (produção): postgresql+psycopg2://user:password@localhost:5432/ai_consulting
DB_ECHO=false

# Segurança
SECRET_KEY=TROQUE_ESTA_CHAVE_EM_PRODUCAO_USE_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# IA — OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
MAX_TOKENS_RESPONSE=2048
