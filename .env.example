# Configurações da aplicação — copie este arquivo para .env e preencha
APP_NAME="AI Consulting Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Banco de dados
# SQLite (desenvolvimento):
DATABASE_URL=sqlite:///./ai_consulting.db
# PostgreSQL (produção): postgresql+psycopg2://user:password@localhost:5432/ai_consulting
DB_ECHO=false

# Segurança
# Obrigatória (mín. 32 caracteres). Gere com: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Rate limit do login
LOGIN_JANELA_SEGUNDOS=900
LOGIN_MAX_TENTATIVAS_IP=20
LOGIN_MAX_FALHAS_EMAIL=5

# Primeiro ADMIN (usado só pelo seed_db.py; senha mín. 12 caracteres)
ADMIN_EMAIL=
ADMIN_SENHA=

# IA — OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
MAX_TOKENS_RESPONSE=2048
