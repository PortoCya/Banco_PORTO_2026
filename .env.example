# Copie para .env e preencha. O .env NUNCA vai para o git.
# Nenhum valor real (chave, senha, token) deve ser escrito neste arquivo de exemplo.

DEBUG=false

# ── Banco de dados ────────────────────────────────────────────────────────────
# Desenvolvimento rápido (SQLite):
DATABASE_URL=sqlite:///./nps_keycore.db
# PostgreSQL (produção / docker compose):
# DATABASE_URL=postgresql+psycopg://nps_api:<senha>@localhost:5432/nps
# Usuário de banco do worker de IA (só escreve nas tabelas de IA — ver scripts/permissoes_worker.sql)
# WORKER_DATABASE_URL=postgresql+psycopg://nps_worker:<senha>@localhost:5432/nps
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SEGUNDOS=5
DB_STATEMENT_TIMEOUT_MS=15000

# ── Redis (fila da IA, rate limit compartilhado, contador de custo) ──────────
# Opcional em desenvolvimento. Sem ele: rate limit por processo e worker por varredura do banco.
# REDIS_URL=redis://localhost:6379/0

# ── Segurança ─────────────────────────────────────────────────────────────────
# Obrigatória (mín. 32 caracteres). Gere com: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
# false só em desenvolvimento sem HTTPS
COOKIE_SECURE=true

# Rate limit
LOGIN_JANELA_SEGUNDOS=900
LOGIN_MAX_TENTATIVAS_IP=20
LOGIN_MAX_FALHAS_EMAIL=5
PUBLICO_MAX_LEITURAS_IP=60
PUBLICO_MAX_ENVIOS_IP=20

# ── Primeiro ADMIN (usado só pelo seed_db.py; senha de 12 a 128 caracteres) ──
ADMIN_EMAIL=
ADMIN_SENHA=

# ── Camada de IA (lida só pelo worker) ───────────────────────────────────────
# Endpoint compatível com chat completions. Gemini (padrão) ou, p. ex., https://api.openai.com/v1
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_API_KEY=
IA_TIMEOUT_RESPOSTA_SEGUNDOS=30
IA_MAX_TENTATIVAS=5
# Custo por 1.000 tokens (mesma moeda do limite) — alimenta o circuit breaker
IA_CUSTO_1K_TOKENS_ENTRADA=0
IA_CUSTO_1K_TOKENS_SAIDA=0
IA_LIMITE_CUSTO_PADRAO=50

# ── Só para o docker compose ─────────────────────────────────────────────────
# Senhas dos usuários de banco (API e worker). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
WORKER_DB_PASSWORD=
# IP do proxy reverso autorizado a informar o IP real do cliente (X-Forwarded-For)
PROXY_IPS=127.0.0.1
